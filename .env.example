# MANTIS Environment Configuration
# Copy this to .env and modify values

# Server
MANTIS_PORT=3000
MANTIS_HOST=0.0.0.0
MANTIS_ENV=production

# JWT Authentication
MANTIS_JWT_SECRET=change_this_to_a_secure_random_string_64_chars_minimum
MANTIS_JWT_EXPIRES_IN=24h

# Redis (optional - falls back to in-memory if unavailable)
MANTIS_REDIS_ENABLED=false
MANTIS_REDIS_HOST=127.0.0.1
MANTIS_REDIS_PORT=6379
MANTIS_REDIS_PASSWORD=
MANTIS_REDIS_DB=0

# Database
MANTIS_DB_FILE=storage.db

# Detection Engine
MANTIS_SCAN_INTERVAL=10
MANTIS_ANALYSIS_WINDOW=300
MANTIS_ML_CONTAMINATION=0.1
MANTIS_BLOCK_TTL=3600
MANTIS_PERM_BLOCK_THRESHOLD=5

# Logging
MANTIS_LOG_LEVEL=info
MANTIS_LOG_FILE=logs/mantis.log
MANTIS_SECURITY_LOG_FILE=logs/security.log

# WebSocket
MANTIS_WS_ENABLED=true
MANTIS_WS_PORT=3001

# Alerting (optional)
MANTIS_ALERTING_ENABLED=false
MANTIS_WEBHOOK_URL=
MANTIS_SLACK_WEBHOOK_URL=
