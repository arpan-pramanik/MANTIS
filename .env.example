# ==========================================
# MANTIS ENVIRONMENT CONFIGURATION
# ==========================================
# DO NOT commit the actual .env file to version control.
# Copy this file to .env and populate with real values.

# -----------------
# Node.js Gateway
# -----------------
NODE_ENV=development
MANTIS_PORT=3000
MANTIS_WS_PORT=3001
MANTIS_LOG_LEVEL=info

# Upstream proxy target (The API you are protecting)
# Example: http://localhost:8080
UPSTREAM_API_URL=http://localhost:8080

# Gateway Authentication Secret
# Must be at least 32 characters
MANTIS_JWT_SECRET=super_secret_jwt_key_example_change_me_in_prod

# Admin API Key for external script access
MANTIS_API_KEY=admin_api_key_example_change_me

# -----------------
# Python Threat Engine
# -----------------
ENGINE_POLL_INTERVAL_MS=500
ANOMALY_THRESHOLD=0.85

# -----------------
# Database / Storage
# -----------------
# Currently defaults to local SQLite WAL mode
DB_PATH=./data/storage.db

# Redis connection (Optional - planned for v0.2.0)
# REDIS_URL=redis://localhost:6379/0

# -----------------
# Observability
# -----------------
GRAFANA_ADMIN_PASSWORD=admin
