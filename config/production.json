{
  "environment": "production",
  "jwt": {
    "secret": "MUST_BE_SET_VIA_ENVIRONMENT_VARIABLE",
    "expiresIn": "12h"
  },
  "rateLimit": {
    "global": {
      "windowMs": 60000,
      "maxRequests": 60
    },
    "auth": {
      "windowMs": 900000,
      "maxRequests": 10
    }
  },
  "redis": {
    "enabled": true
  },
  "detection": {
    "scanInterval": 5,
    "blockTTLSeconds": 7200,
    "permanentBlockThreshold": 3
  },
  "logging": {
    "level": "warn",
    "console": false
  },
  "inputValidation": {
    "maxBodySize": "512kb"
  }
}
