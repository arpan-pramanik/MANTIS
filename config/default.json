{
  "port": 3000,
  "host": "0.0.0.0",
  "environment": "development",
  "jwt": {
    "secret": "CHANGE_THIS_IN_PRODUCTION_mantis_jwt_secret_2024",
    "expiresIn": "24h",
    "issuer": "mantis-api-sentinel"
  },
  "rateLimit": {
    "global": {
      "windowMs": 60000,
      "maxRequests": 100
    },
    "auth": {
      "windowMs": 900000,
      "maxRequests": 15
    },
    "admin": {
      "windowMs": 60000,
      "maxRequests": 30
    }
  },
  "redis": {
    "host": "127.0.0.1",
    "port": 6379,
    "password": "",
    "db": 0,
    "keyPrefix": "mantis:",
    "enabled": false
  },
  "database": {
    "file": "storage.db",
    "walMode": true,
    "busyTimeout": 5000
  },
  "detection": {
    "scanInterval": 10,
    "analysisWindowSeconds": 300,
    "mlContamination": 0.1,
    "minSamplesForML": 5,
    "blockTTLSeconds": 3600,
    "permanentBlockThreshold": 5,
    "threatLevels": {
      "critical": 0.9,
      "high": 0.7,
      "medium": 0.5,
      "low": 0.3
    }
  },
  "mitigation": {
    "graduatedResponse": true,
    "stages": ["warn", "throttle", "tempBlock", "permBlock"],
    "tempBlockDurationSeconds": 3600,
    "throttleDelayMs": 2000,
    "maxStrikes": 3
  },
  "logging": {
    "level": "info",
    "file": "logs/mantis.log",
    "securityFile": "logs/security.log",
    "maxSize": "50m",
    "maxFiles": 10,
    "console": true
  },
  "websocket": {
    "enabled": true,
    "port": 3001,
    "path": "/ws/threats"
  },
  "inputValidation": {
    "maxBodySize": "1mb",
    "maxUrlLength": 2048,
    "maxHeaderSize": 8192
  },
  "ipIntelligence": {
    "blockPrivateRanges": false,
    "trustProxy": ["127.0.0.1", "::1"],
    "cidrBlocklist": []
  },
  "signatures": {
    "file": "config/signatures.json",
    "autoUpdate": false
  },
  "alerting": {
    "enabled": false,
    "webhookUrl": "",
    "slackWebhookUrl": "",
    "emailEnabled": false
  }
}
